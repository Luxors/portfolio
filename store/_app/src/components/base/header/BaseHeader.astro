---
import './_base-header.scss';

import BaseLogo from '@/components/base/logo/BaseLogo.astro';
import BaseMenu from '@/components/base/menu/BaseMenu.astro';
import BaseToolbar from '@/components/base/toolbar/BaseToolbar.astro';
---

<header class="base-header">
  <div class="container container-lg">
    <div class="row">
      <div class="col col-3">
        <BaseLogo />
      </div>

      <div class="col col-6 col-center">
        <BaseMenu />
      </div>

      <div class="col col-3 col-end">
        <BaseToolbar />
      </div>
    </div>
  </div>
</header>
