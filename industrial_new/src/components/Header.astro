---
import "@/assets/styles/header.css";

import { Image } from "astro:assets";

import Logo from "@/assets/images/logo.png";
import IconSearch from "@/assets/images/icons/search.svg";
import IconShoppingBag from "@/assets/images/icons/shopping-bag.svg";

const currentPath = Astro.url.pathname;

const menuItems = [
  { href: "/", text: "home" },
  { href: "/catalog", text: "catalog" },
  { href: "/contacts", text: "contacts" },
  { href: "/login", text: "sign in" },
  { href: "/admin", text: "admin" },
];

const toolbarItems = [
  { id: "search", icon: IconSearch },
  { id: "cart", href: "/cart", icon: IconShoppingBag },
];

const toolbarIconSize = 32;
---

<header class="app-header">
  <a class="app-logo" href="index.html">
    <Image
      src={Logo}
      alt="Industrial"
      width={265}
      height={65}
      class="app-logo__image"
    />
  </a>
  <nav class="app-nav">
    {menuItems.map((item) => (
      <a
        href={item.href}
        class:list={[
          "app-nav__link",
          { "app-nav__link--active": currentPath === item.href },
        ]}
      >
        {item.text}
      </a>
    ))}
  </nav>
  <ul class="app-toolbar">
    <li class="app-toolbar__item">
      <button type="button" class="app-toolbar__control">
        <IconSearch class="app-toolbar__icon" />
      </button>
    </li>
    <li class="app-toolbar__item">
      <a href="cart.html" class="app-toolbar__control">
        <IconShoppingBag class="app-toolbar__icon" />
      </a>
    </li>
    <!-- <div class="burger">
      <img src="img/bars.png" alt="cart" class="cart__img" />
    </div> -->
  </ul>
</header>
